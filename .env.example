# Owner login (set these in Vercel -> Settings -> Environment Variables)
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=choose-a-strong-password
OWNER_SESSION_SECRET=any-long-random-string-32-chars-or-more
# Optional WhatsApp fallback number (digits, with country code)
WHATSAPP_NUMBER=
# Razorpay (leave empty until your account is verified)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Live try-on (Check Live) — Decart API key from platform.decart.ai (server only)
DECART_API_KEY=

# WhatsApp order alerts to the owner (Meta WhatsApp Cloud API) — server only
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
OWNER_WHATSAPP_TO=919876543210
WHATSAPP_TEMPLATE_NAME=new_order_alert
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v21.0

# PhonePe Payment Gateway (UPI / PhonePe checkout with automatic confirmation) — server only
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
# sandbox while testing, production when live
PHONEPE_ENV=sandbox
# optional: your live website address, e.g. https://aadhya.vercel.app
NEXT_PUBLIC_SITE_URL=

# AI Style Ideas (cloth -> outfit pictures) — Google AI Studio key (free tier available), server only
GEMINI_API_KEY=
# optional: change model later (e.g. when you upgrade to a paid plan)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# AI Style Ideas via Cloudflare Workers AI (free daily allowance, no card) — recommended
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
# which one to use when both are set: cloudflare or gemini
IMAGE_PROVIDER=cloudflare

# More AI services for Style Ideas (optional — each is used automatically when the one before it runs out)
STABILITY_API_KEY=
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-kontext-pro
# order to try them (comma separated)
IMAGE_PROVIDER_ORDER=cloudflare,gemini,stability,replicate
